# ─────────────────────────────────────────────────────────────────────────────
# Переменные окружения проекта. Здесь только ИМЕНА и пояснения — значений нет
# и быть не должно: репозиторий публичный. Реальные значения лежат в Vercel
# (Project → Settings → Environment Variables) и запрашиваются у владельца.
#
# Локально: скопируйте файл в .env.local и заполните. .env* в .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ядро: без этого не работает ничего ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=          # токен бота от @BotFather
TELEGRAM_CHAT_ID=            # id группы, куда шлётся отчёт (для групп — отрицательный)
CRON_SECRET=                 # общий секрет: авторизует /api/report, /api/monitor и вебхук Telegram
BLOB_READ_WRITE_TOKEN=       # Vercel Blob — хранилище снапшотов; Vercel подставляет сам при подключённом сторе

# ── Instagram: аккаунт @daristeppe (основной) ────────────────────────────────
IG_USER_ID=                  # id бизнес-аккаунта Instagram
IG_ACCESS_TOKEN=             # долгоживущий токен; после первого запуска хранится в Blob и обновляется сам

# ── Instagram: второй аккаунт @qurany_app (необязательно) ────────────────────
IG_USER_ID_QURANY_APP=
IG_ACCESS_TOKEN_QURANY_APP=

# ── Темы форума в группе (необязательно; без них — в общий чат) ──────────────
TELEGRAM_THREAD_ID=          # тема для ежедневного отчёта
TELEGRAM_ALERT_THREAD_ID=    # тема для алертов монитора

# ── Google Sheets: выгрузка таблицы рилсов (необязательно) ───────────────────
GOOGLE_SA_EMAIL=             # сервисный аккаунт Google; дайте ему доступ к таблице
GOOGLE_SA_PRIVATE_KEY=       # приватный ключ сервисного аккаунта (с \n внутри строки)
SHEETS_SPREADSHEET_ID=       # id таблицы из её URL
SHEETS_TAB=                  # по умолчанию Reels
SHEETS_HISTORY_TAB=          # по умолчанию History
SHEETS_TAB_QURANY_APP=       # по умолчанию «Reels qurany_app»
SHEETS_HISTORY_TAB_QURANY_APP=

# ── PostHog: блок «Заходы по ссылкам» (необязательно) ────────────────────────
POSTHOG_PERSONAL_API_KEY=    # персональный ключ с правом чтения (phx_…)
POSTHOG_PROJECT_ID=
POSTHOG_HOST=                # по умолчанию us.posthog.com

# ── Реклама Meta: блок «Таргет» — расходы, лиды, цена за результат ───────────
META_AD_ACCOUNT_ID=          # id рекламного кабинета, без префикса act_
META_ADS_TOKEN=              # токен доступа к Marketing API; продлевается сам через app secret
META_APP_ID=
META_APP_SECRET=
META_CURRENCY=               # валюта кабинета, например USD
META_LEAD_ACTION_TYPE=       # какое действие считать лидом в статистике Meta

# ── Лиды квиза (необязательно; без них блок «Потенциал инвестора» скрыт) ─────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Монитор сайтов и рекламного кабинета ────────────────────────────────────
MONITOR_URLS=                # список адресов через запятую

# ── Ссылки амбассадоров в стор: /go/<слаг> ──────────────────────────────────
APPSTORE_LIVE=               # 1 — приложение опубликовано, вести в App Store
APPSTORE_PROVIDER_TOKEN=     # токен App Store Connect для статистики переходов
IOS_FALLBACK_URL=            # куда вести, пока приложения нет в сторе

# ── Ферма рилсов: сбор и автопубликация ─────────────────────────────────────
FARM_IG_ID=                  # id аккаунта, куда публикуются Trial Reels
FARM_IG_TOKEN=               # его токен; дальше хранится в Blob
FARM_TOKEN_SECRET=           # секрет для подписи одноразовых ссылок на загрузку
FARM_BASE_URL=               # базовый адрес приложения; по умолчанию берётся из Vercel
FARM_TZ=                     # по умолчанию Asia/Jakarta
FARM_SLOT_START=             # начало окна публикаций, например 05:00
FARM_SLOT_END=               # конец окна, например 00:30
FARM_SLOTS_PER_DAY=          # сколько роликов в сутки
FARM_SLOT_MINUTES=           # шаг сетки слотов в минутах
FARM_FONT_PATH=              # шрифт для подписей на обложке
FARM_FFMPEG_PATH=            # путь к ffmpeg; на Vercel подставляется из пакета
FARM_FFPROBE_PATH=           # путь к ffprobe

# ── Бот дубляжа RU → бахаса ─────────────────────────────────────────────────
DUB_BOT_TOKEN=               # отдельный бот дубляжа от @BotFather
ELEVENLABS_API_KEY=          # ключ ElevenLabs (дубляж и Scribe)
DUB_WEBHOOK_SECRET=          # секрет вебхука дубляжа; им же подписаны ссылки на /dub/<токен>
DUB_ALLOWED_CHAT_IDS=        # кому разрешено пользоваться, id через запятую
TG_ALLOWED_CHAT_IDS=         # то же для локального запуска dub-bot.mjs
DUB_SPEAKERS=                # число говорящих в ролике, по умолчанию 1
DUB_WATERMARK=               # 1 — оставить водяной знак ElevenLabs

# ── Ставится платформой, вручную задавать не нужно ──────────────────────────
# VERCEL_PROJECT_PRODUCTION_URL
